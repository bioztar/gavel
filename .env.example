# Discord — TWO separate applications, one per side
DISCORD_CONCIERGE_TOKEN=
DISCORD_EARS_TOKEN=

# Nebius Token Factory (brain). Models are picked in packages/brain/config/models.yaml;
# BRAIN_MODEL_FAST / BRAIN_MODEL_NORMAL override them for a quick A/B.
NEBIUS_API_KEY=
# BRAIN_MODEL_FAST=deepseek-ai/DeepSeek-V4.1-Flash
# BRAIN_MODEL_NORMAL=deepseek-ai/DeepSeek-V4.1-Flash
# CHAIR_PERSONA=funky                # formal | funky

# Langfuse (brain): traces every model call, one Langfuse session per meeting.
# Off unless both keys are set. LANGFUSE_BASE_URL defaults to https://cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production

# SLNG (ears + mouth)
SLNG_API_KEY=

# Seam between the two halves
EARS_WIRE_URL=ws://localhost:8787
# ears is also the brain's store (memories, interventions, llm_calls) — same Postgres
EARS_HTTP_URL=http://localhost:8787
# Agenda used when an ears session starts without one
# AGENDA_FILE=packages/contract/fixtures/agenda.demo.json
CONCIERGE_WEBHOOK_URL=http://localhost:8788/events
SEAM_SHARED_SECRET=
WIRE_PORT=8787
STAGE_PORT=8788
# Bind hosts default to 127.0.0.1 locally. The root Compose file overrides both to
# 0.0.0.0 inside their containers and publishes the ports on host loopback only.
# WIRE_HOST=127.0.0.1
# STAGE_HOST=127.0.0.1
# ears proxies this read-only endpoint into its operator console.
BRAIN_STATE_URL=http://127.0.0.1:8788/state

# Fire drill (B11). Demo phone in the room. NEVER an emergency service number.
EMERGENCY_DEMO_NUMBER=

# ears-discord (packages/ears-discord) — all optional; defaults match its docker-compose
# Discord meeting channels are selected per server in the ears console.
# DISCORD_LEAVE_GRACE_SECONDS=10
# Live meeting-status message; per-server channel and on/off are set in the console.
# DISCORD_STATUS_ENABLED=true
# Legacy one-server deployment seed (prefer the console):
# DISCORD_GUILD_ID=
# DISCORD_VOICE_CHANNEL_ID=
# One Postgres for everything. ears owns the call tables, brain's Mastra uses schema
# `mastra`, and calendar owns `calendar_invites` on its own Alembic lineage
# (`alembic_version_calendar`). calendar reads this too — without it every /m/ link
# dies with the container, which its GET /health reports as "durable": false.
# POSTGRES_DSN=postgresql+asyncpg://gavel:gavel@localhost:5432/gavel
# REDIS_DSN=redis://localhost:6379/0
# SLNG_BASE_URL=https://eu-west.api.slng.ai
# SLNG_STT_MODEL=deepgram/nova:3
# Karen's voice. This is the STARTUP DEFAULT only: the console picks the voice live
# (say-box and chair alike) and the choice is stored in `app_settings.tts_voice`, so
# once someone has picked, that is what the next boot uses instead of this.
# SLNG_TTS_MODEL=deepgram/aura:2
# SLNG_TTS_VOICE=aura-2-thalia-en
# Ids offered by the console's picker, comma-separated. Empty uses the built-in list.
# The picker also accepts a typed id, so this is convenience, never a whitelist.
# SLNG_TTS_VOICES=
# TURN_GAP_MS=1500
# TURN_TICK_MS=10000
# Audio below this 16-bit RMS level is noise: it does not count as floor time.
# SILENCE_RMS=60
# Keep speech active briefly after the last above-threshold audio frame.
# VOICE_ACTIVITY_HOLD_MS=300

# calendar (packages/calendar) — all optional; defaults shown
# EARS_API_URL=http://localhost:8787       # ears-discord's HTTP API (POST /api/meetings, /api/sessions)
# CALENDAR_HOST=0.0.0.0
# CALENDAR_PORT=8790
# CALENDAR_PUBLIC_URL=https://gavel.pro7ocol.com
# CALENDAR_ATTENDEE_MAP=                   # "email1=discordId1,email2=discordId2"
# Per-session policy overrides for meetings this service creates (JSON, keys from
# schema.EARS_DEFAULT_POLICY). Unset = send no policy, ears uses its own defaults.
# CALENDAR_POLICY_OVERRIDES={"offAgendaGraceSeconds": 8, "requireStart": false}
# SCHEDULER_POLL_SECONDS=30

# calendar: compose ("set up a meeting" front door) — all optional; defaults shown
# RESEND_API_KEY=                          # empty: mailer runs dry-run, meeting still created
# COMPOSE_FROM_EMAIL=                      # must be on a Resend-verified sending domain
# COMPOSE_DEFAULT_ATTENDEES=               # "Name <email>, Name <email>, ..." prefills GET /compose
# DISCORD_MEETING_URL=                     # .ics LOCATION and the success page's Discord link
# COMPOSE_TIMEZONE=Europe/Madrid           # IANA name; also what "in one hour" resolves against

# Single-VPS public calendar route (the operator console remains private over SSH)
# GAVEL_DOMAIN=gavel.pro7ocol.com
# The decks are served at https://${GAVEL_DOMAIN}/docs/ by the `docs` service.
# DOCS_PORT is only the loopback port for poking it locally.
# DOCS_PORT=8799
# The decks are also served at the root of their own name.
# CLOTURE_DOMAIN=cloture.pro7ocol.com
# TRAEFIK_NETWORK=traefik-public
# CALENDAR_PORT=8790
# CALENDAR_ICS_FEEDS=                      # comma-separated Google Calendar "Secret address in
#                                           # iCal format" URLs (Settings > Integrate calendar).
#                                           # This is a credential — never a real value here, never
#                                           # committed. Empty: manual POST /invite still works.
# CALENDAR_FEED_WINDOW_HOURS=24            # only feed events starting within this window are ingested

# Devin (Cognition). DEVIN_PAT_KEY is a cog_-prefixed Personal Access Token and is
# a credential; DEVIN_ORG_ID is an identifier and is required in every v3 URL:
#   https://api.devin.ai/v3/organizations/$DEVIN_ORG_ID/sessions
# GET https://api.devin.ai/v3/self returns both, which is how the org id was found.
# Legacy /v1 endpoints reject a cog_ key with 403 — that is the key type, not the key.
DEVIN_PAT_KEY=
DEVIN_ORG_ID=

# --- ears-meet: Karen in a Google Meet ------------------------------------------------
# Brought up with the `meet` compose profile:  docker compose --profile meet up -d ears-meet
# Nothing here is a credential EXCEPT the profile directory, which is not a value at all —
# it is a signed-in Chromium profile on disk. See docs/EARS-MEET.md section 6.
MEET_URL=                                  # https://meet.google.com/xxx-yyyy-zzz
MEET_BOT_NAME=Karen (gavel)                # the name in the participant tile
# THE CREDENTIAL. A Chromium profile signed in as Karen's Google account, made once on a
# machine with a screen (`just login`) and copied to this host. Never commit it; keep it
# under secrets/ (gitignored). Inside the container it is always mounted at /profile.
MEET_PROFILE_HOST_DIR=./secrets/meet-profile
# MEET_FACE_IMAGE=assets/persona/karen-formal.png  # her camera tile: a still, published as
#                                                  # a real video track. Unset = camera off.
# MEET_FACE_FPS=5
# MEET_CAPTIONS=true
# MEET_ADMIT_TIMEOUT_S=180                 # how long she waits in the lobby to be let in
# MEET_LEAVE_WHEN_ALONE_S=120
# MEET_STAGE_URL=http://stage:8793/        # the board she shares; found by tab title
# STAGE_TAB_TITLE=gavel-stage
# MEET_WIRE_PORT=8797                      # host port for ears-meet's wire (8787 is Discord's)
# MEET_AGENDA_FILE=/app/contract/fixtures/agenda.demo.json

# Point the brain at whichever ears is chairing. Default is Discord; for a Meet demo:
# EARS_WIRE_URL=ws://ears-meet:8787
# EARS_HTTP_URL=http://ears-meet:8787

# --- stage: the live board Karen screen-shares ---------------------------------------
# STAGE_BOARD_PORT=8793                    # host port. NOT STAGE_PORT — brain owns that name.
# BRAIN_POLL_MS=1000

# --- ears operator console, published ------------------------------------------------
# The console is the control plane (start/end sessions, TTS say-box). Both must be set
# before it is reachable on the public domain, and it is always behind basic auth.
# Set them with scripts/set-console-auth.sh — never by hand, never a plaintext password.
GAVEL_CONSOLE_PUBLIC=
GAVEL_CONSOLE_USERS=
