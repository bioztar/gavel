{
  "name": "@gavel/brain",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "replay": "tsx src/replay.ts",
    "evals": "tsx evals/run.ts",
    "studio": "mastra dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p evals"
  },
  "dependencies": {
    "@mastra/core": "^1.67.0",
    "@mastra/langfuse": "^1.5.7",
    "@mastra/observability": "^1.17.8",
    "@mastra/pg": "^1.25.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "dotenv": "^18.0.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "mastra": "^1.30.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
