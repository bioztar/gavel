# Local development ONLY:  docker compose --env-file .env --env-file docker/dev.env up -d
#
# compose.yaml has no defaults for these on purpose — a deployed host must set real
# values in .env. Every value below is weak and public; listing it later on the command
# line makes the choice explicit, and nothing here may ever be copied into a real .env.
POSTGRES_USER=gavel
POSTGRES_PASSWORD=gavel
POSTGRES_DB=gavel
# Not a secret: it only has to be non-empty so the brain and calendar can reach ears'
# /api/* while the console's basic auth is on. Real deployments: `openssl rand -hex 32`.
SEAM_SHARED_SECRET=dev-only-seam-not-a-secret
# The three explicit opt-outs. Each one is a public host's worst idea.
CONSOLE_AUTH_REQUIRED=false
CALENDAR_AUTH_REQUIRED=false
